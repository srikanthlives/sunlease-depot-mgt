# Copy to .env and fill in. Used by docker-compose.yml.

# Required. JWT signing key. Generate with: openssl rand -hex 32
DEPOT_SECRET_KEY=

# Optional. HRMS sync integration; leave empty to disable.
DEPOT_HRMS_SYNC_URL=
DEPOT_HRMS_SYNC_TOKEN=

# --- Optional overrides (defaults in backend/app/core/config.py) ---
# DEPOT_DATABASE_URL=sqlite:///../data/depot.db
# DEPOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEPOT_SCAN_DIR=/data/scans
# PORT=8030

# --- Frontend (Vite; put in frontend/.env.local for dev) ---
# VITE_API_URL=http://localhost:8030
